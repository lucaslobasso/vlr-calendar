{
  "manifest_version": 3,
  "name": "VLR Calendar",
  "description": "Add individual VLR.gg Valorant matches to Google Calendar with one click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vlr.gg/*", "https://vlr.gg/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
